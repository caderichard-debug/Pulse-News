# Database (local Docker default)
# Production: copy to .env.production and use schema-scoped Supabase URL.
# Direct host (IPv6 / async-friendly):
# DATABASE_URL=postgresql://app_pulse_rw:<PASSWORD>@db.<PROJECT_REF>.supabase.co:5432/postgres?sslmode=require&schema=proj_pulse
# Session pooler (IPv4-friendly sync/psycopg2 on Railway, etc.) — use your REGION from Supabase dashboard:
# DATABASE_URL=postgresql://app_pulse_rw.<PROJECT_REF>:<PASSWORD>@aws-0-<REGION>.pooler.supabase.com:5432/postgres?sslmode=require&schema=proj_pulse
# See docs/guides/SUPABASE_SCHEMA_ISOLATION_PORTABLE_GUIDE.md and backend/sql/supabase_schema_isolation.sql
DATABASE_URL=postgresql://postgres:password@db:5432/news_db

# Supabase (production only)
SUPABASE_PROJECT_REF=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Leave empty for local Docker / pytest so tables stay in public. Set proj_pulse for isolated Supabase deploys.
SUPABASE_DB_SCHEMA=
SUPABASE_DB_ROLE=app_pulse_rw
SUPABASE_DB_PASSWORD=

# OpenAI API Key (REQUIRED for AI features)
# Get your key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-your-key-here

# Resend API Key (REQUIRED for newsletter sending)
# Get your key from: https://resend.com/api-keys
RESEND_API_KEY=re_your-key-here

# Application Settings
SECRET_KEY=your-secret-key-change-in-production-use-long-random-string
ENVIRONMENT=development
DEBUG=true
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000

# Email Configuration
# Use Resend's default test domain (no domain verification needed)
FROM_EMAIL=onboarding@resend.dev
FROM_NAME=Pulse News

# AI Configuration
AI_MODEL=gpt-4o-mini
MAX_TOKENS_PER_REQUEST=2000
BATCH_SIZE=5

# Scraping Configuration
SCRAPE_INTERVAL_HOURS=3
PROCESS_INTERVAL_HOURS=4
MAX_ARTICLES_PER_SOURCE=10

# Newsletter Configuration
NEWSLETTER_SEND_HOUR=7
MAX_ARTICLES_PER_NEWSLETTER=5
MAX_FRAMEWORKS_PER_NEWSLETTER=3

# Statistics Verification - Web Search (OPTIONAL but recommended)
# Enables Method 2 web search for source tracing
# Get API key from: https://console.cloud.google.com/apis/credentials
# Create Custom Search Engine at: https://programmablesearchengine.google.com/
GOOGLE_FACT_CHECK_API_KEY=your-google-api-key-here
GOOGLE_SEARCH_ENGINE_ID=your-custom-search-engine-id-here
