{
  "version": 3,
  "functions": {
    "backend/app/main.py": {
      "runtime": "python3.11"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/backend/app/main"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/backend/app/main"
    }
  ]
}
