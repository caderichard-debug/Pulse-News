{
  "manifest_version": 3,
  "name": "Pulse News Analyzer",
  "version": "1.0",
  "description": "Analyze news articles with AI-powered insights from Pulse",
  "permissions": ["tabs", "activeTab", "sidePanel"],
  "host_permissions": ["https://pulsenews.app/*", "http://localhost:3000/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Analyze with Pulse"
  },
  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
