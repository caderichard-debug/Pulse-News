# Database
DATABASE_URL=postgresql://postgres:password@db:5432/news_db

# OpenAI API Key (REQUIRED for AI features)
# Get your key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-your-key-here

# Resend API Key (REQUIRED for newsletter sending)
# Get your key from: https://resend.com/api-keys
RESEND_API_KEY=re_your-key-here

# Application Settings
SECRET_KEY=your-secret-key-change-in-production-use-long-random-string
ENVIRONMENT=development
DEBUG=true
FRONTEND_URL=http://localhost:3000
FRONTEND_CUSTOM_URL=https://pulsenews.app
BACKEND_URL=http://localhost:8000
AUTH_URL=https://auth.pulsenews.app

# OAuth Configuration (Google Sign-In)
# Get your credentials from: https://console.cloud.google.com/apis/credentials
GOOGLE_AUTH_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_AUTH_CLIENT_SECRET=your-google-client-secret

# Email Configuration
FROM_EMAIL=newsletter@pulsenews.app
FROM_NAME=Pulse News

# AI Configuration
AI_MODEL=gpt-4o-mini
MAX_TOKENS_PER_REQUEST=2000
BATCH_SIZE=5

# Scraping Configuration
SCRAPE_INTERVAL_HOURS=3
PROCESS_INTERVAL_HOURS=4
MAX_ARTICLES_PER_SOURCE=10

# Newsletter Configuration
NEWSLETTER_SEND_HOUR=7
MAX_ARTICLES_PER_NEWSLETTER=5
MAX_FRAMEWORKS_PER_NEWSLETTER=3
